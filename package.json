{
  "name": "n8n-nodes-telegram-userbot",
  "version": "1.1.0",
  "description": "Enhanced n8n community node for Telegram User Bot (MTProto) with pagination and fast message fetching",
  "keywords": [
    "n8n-community-node-package",
    "telegram",
    "userbot",
    "mtproto",
    "gramjs",
    "pagination"
  ],
  "license": "MIT",
  "homepage": "https://github.com/darakcheeff/n8n-nodes-telegram-userbot",
  "author": {
    "name": "darakcheeff",
    "url": "https://github.com/darakcheeff"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/darakcheeff/n8n-nodes-telegram-userbot.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier --write .",
    "lint": "eslint src --ext .ts",
    "login": "ts-node --project scripts/tsconfig.json scripts/login.ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/TelegramUserBotApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/TelegramUserBot/TelegramUserBot.node.js",
      "dist/nodes/TelegramUserBot/TelegramUserBotTrigger.node.js",
      "dist/nodes/TelegramUserBot/TelegramUserBotHealthCheck.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.0.0",
    "prettier": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "telegram": "^2.22.2",
    "input": "^1.0.1",
    "big-integer": "^1.6.52"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
